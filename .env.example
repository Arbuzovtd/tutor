# Copy to .env and fill in real values. Never commit the .env file.

# === Required ===
# Get from @BotFather: /newbot → choose name → choose @username
TELEGRAM_BOT_TOKEN=
# Random long string. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-to-something-long-and-random

# === OpenAI / Polza (optional — bot stays silent on student messages without it) ===
OPENAI_API_KEY=
# Polza users: uncomment to route through https://polza.ai
# OPENAI_BASE_URL=https://api.polza.ai/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=300

# === Database (Docker Compose injects DATABASE_URL automatically; override only for external DB) ===
# POSTGRES_USER=tutorbot
# POSTGRES_DB=tutorbot
# DATABASE_URL=postgresql+asyncpg://tutorbot:password@db:5432/tutorbot

# === Misc ===
LOG_LEVEL=INFO
ENVIRONMENT=prod
# SENTRY_DSN=
